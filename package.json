{
  "name": "polish-http-stremio-addon",
  "version": "1.0.0",
  "description": "Stremio HTTP addon exposing stream links from Polish streaming sites (via movies-series-fetcher)",
  "type": "module",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "npm run build --prefix ../movies-series-fetcher && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "movies-series-fetcher": "file:../movies-series-fetcher"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
