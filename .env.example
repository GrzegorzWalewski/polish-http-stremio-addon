# TMDB Read Access Token (JWT) — https://www.themoviedb.org/settings/api
TMDB_READ_TOKEN=

# FlareSolverr (optional) — auto Cloudflare bypass for zaluknij/cda-hd
# docker run -d --name flaresolverr -p 8191:8191 --restart unless-stopped ghcr.io/flaresolverr/flaresolverr
FLARESOLVERR_URL=

# filman.cc stays manual (reCAPTCHA on login + UA-bound session):
# paste fresh cf_clearance + session cookies from browser devtools,
# and the browser's User-Agent (cookies are bound to it)
FILMAN_CC_COOKIE=
FILMAN_CC_UA=

# addon HTTP port
PORT=7777
